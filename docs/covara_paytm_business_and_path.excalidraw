   "versionNonce": 735669866,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• Consent before upload, timestamp stored\n• Delete my data: files, results, cached model output\n• Stored claims expire automatically (72 hours by default)\n• No document text in error logs\n• Every finding links to a page; clause quotes are checked word for word\n• Plain code decides issues; AI only reads and explains\n• Never predicts approval; disclaimer on every screen\n• Demo uses synthetic data only",
   "originalText": "• Consent before upload, timestamp stored\n• Delete my data: files, results, cached model output\n• Stored claims expire automatically (72 hours by default)\n• No document text in error logs\n• Every finding links to a page; clause quotes are checked word for word\n• Plain code decides issues; AI only reads and explains\n• Never predicts approval; disclaimer on every screen\n• Demo uses synthetic data only",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15
  },
