# Copy to .env and fill in values. Never commit .env.
APP_ENV=development

# Comma-separated browser origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

MAX_UPLOAD_MB=20

# AI providers - all optional; the app starts without them.
# Claude (Anthropic) is the primary provider: https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
# Low-cost model by default. Set a larger model only if extraction quality needs it.
ANTHROPIC_MODEL=claude-haiku-5-5
# Model for the no-API-key path (`claude -p`). Empty = use your Claude Code session's own model.
CLAUDE_CLI_MODEL=haiku
# Check each provider's current docs for valid model names.
# Production: set LLM_PROVIDERS=gemini so only Gemini is used (no Claude session or key needed).
LLM_PROVIDERS=claude,gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=
SARVAM_API_KEY=
